# CubeTech Events - environment settings
# Copy this file to .env and change the values. Never commit the real .env file.
# (config.php creates .env from this file automatically on first run, with a random APP_KEY.)

APP_NAME="CubeTech Events"
APP_URL=http://localhost/cubetech
# Long random secret used to sign ticket links. Generate one with:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me-to-a-long-random-string
# Show error details on screen (true for local development, false when deployed)
APP_DEBUG=true

# MySQL (XAMPP defaults: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cubetech_events
DB_USER=root
DB_PASS=

# Email (optional)
# Leave MAIL_HOST empty to keep emails in the local outbox (Staff > Email outbox).
# Mailtrap sandbox example: MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525  MAIL_ENCRYPTION=tls
# MAIL_ENCRYPTION can be tls (STARTTLS), ssl (port 465) or none
MAIL_HOST=
MAIL_PORT=2525
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=tickets@cubetech.test
MAIL_FROM_NAME="CubeTech Events"
